# multi-agent-hub configuration — copy to .env and edit.
# .env is gitignored. NEVER commit real values.
#
# Every key here has a working default. You can run the hub with no .env at all;
# `cp .env.example .env` only becomes necessary when you want notifications or
# exact Qwen quota.

# Port the hub listens on. The bind address is always 127.0.0.1 and is not
# configurable — see the Security section of the README for why.
PORT=4319

# Colon-separated roots scanned for git repos to offer in the repo picker.
# Defaults to your home directory.
REPO_ROOTS=

# How deep under each root to look for a .git directory. Raise it if your repos
# nest deeper than this; the scan is breadth-first and stops descending as soon
# as it finds a repo, so the cost of a larger number is modest.
REPO_SCAN_DEPTH=2

# Discord webhook fired when a turn ends, for sessions that have the toggle on.
# Leave blank to disable notifications globally. The per-session toggle lives in
# the session registry, not here.
DISCORD_WEBHOOK_URL=

# Where the session registry and per-session event logs are persisted.
DATA_DIR=./.data

# How often quota is re-collected, in ms. Also the TTL for GET /api/usage, so a
# page load reuses the poller's snapshot instead of hitting the providers again.
# Quota moves slowly; polling harder mostly just spends someone else's rate limit.
# It also costs a Kimi token rotation per poll (its access token lives 900s), which
# rewrites the Kimi CLI's credentials file each time. Don't lower this casually.
USAGE_POLL_MS=1800000

# Ceiling on a single prompt attachment, in bytes. Attachments are written into
# the session's repo under .multi-agent-hub/ (the only place all three agents can
# read from — qwen has no --add-dir) and referenced by absolute path in the prompt.
ATTACHMENT_MAX_BYTES=25000000

# ---------------------------------------------------------------------------
# Usage collection
# ---------------------------------------------------------------------------

# Which agents' quota to collect. Unset means all three. Set a comma-separated
# subset to opt out of one, or an empty value to disable the dashboard entirely.
# A disabled agent still shows a card, with a caveat saying it was turned off —
# a card that silently vanished would read as "no quota" rather than "off".
#
# Worth an explicit decision, because the three providers cost different things:
#   claude — reads ~/.claude/usage-cache.json. A local file read. No auth, no network.
#   kimi   — calls Kimi's usage API with the CLI's own OAuth token, and REWRITES
#            ~/.kimi-code/credentials/kimi-code.json when that token is refreshed.
#            Kimi rotates refresh tokens, so persisting the new one is required for
#            correctness: drop it and the CLI's own credentials break at the next
#            refresh. The write is a merge, atomic (temp file + rename), mode 0600.
#            If you would rather nothing but the Kimi CLI touched that file, put
#            `claude,qwen` here.
#   qwen   — posts a browser session cookie to the Qwen Cloud console endpoint.
#            Falls back to a local token ledger when the cookie is absent or dead.
# USAGE_PROVIDERS=claude,kimi,qwen

# Qwen Cloud console session cookie — the ONLY source of the real credit quota.
# Copy the `login_qwencloud_ticket` cookie value from a logged-in browser on your
# Qwen Cloud billing page. This is a browser session, NOT an OAuth token: there is
# no refresh token, so when it expires you must re-copy it. Until then the hub
# falls back to local token counts and says so on the card.
QWEN_CONSOLE_TICKET=

# Credit totals for the two Qwen quota windows. The console API returns only the
# fraction consumed, not the denominator, so these supply the "X / Y credits"
# readout. Check them against your own billing dashboard — the values below are
# placeholders, not defaults that will be right for your plan.
QWEN_SESSION_CREDITS=
QWEN_WEEKLY_CREDITS=

# IMPORTANT: do NOT set ANTHROPIC_API_KEY here or in the shell that launches the
# hub. The claude CLI prefers it over your subscription's OAuth credentials and
# would bill the API for every turn. The server strips it from the child
# environment as a backstop, but do not rely on that.
